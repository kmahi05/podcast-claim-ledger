# Copy to .env (repo root). Dev-only defaults; real deployments set their own values.

# --- PostgreSQL 16 on localhost:5432 ---
PG_SUPERUSER_URL=postgresql://postgres:postgres@localhost:5432/postgres
MIGRATE_DATABASE_URL=postgresql://pcl_owner:pcl_owner@localhost:5432/podcast_ledger
APP_DATABASE_URL=postgresql+asyncpg://pcl_app:pcl_app@localhost:5432/podcast_ledger
WORKER_DATABASE_URL=postgresql+asyncpg://pcl_worker:pcl_worker@localhost:5432/podcast_ledger

# --- Auth (secrets must be >= 32 bytes) ---
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3002

# --- Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
LLM_CONCURRENCY=4

# --- Local data ---
CHROMA_PATH=./data/chroma
STORAGE_DIR=./data/storage
FILE_URL_SECRET=dev-only-file-url-secret-change-me-0123456789

# --- Transcription (English only; small.en | medium.en | large-v3-turbo, language="en" forced) ---
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# only for the optional diarize extra (pyannote); diarization is off by default
HF_TOKEN=
AUDIO_RETENTION_DAYS=0
